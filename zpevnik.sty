%ARTISTS REGISTRY
% generated/artists.tex (tools/generate.py) registers every artist by slug.
% The lookups print nothing for an unknown slug, and a missing file is fine,
% so a single song still compiles without the generator (Overleaf, D-005).
\makeatletter
\newcommand{\zpregisterartist}[5]{%
  \expandafter\gdef\csname zp@name@#1\endcsname{#2}%
  \expandafter\gdef\csname zp@label@#1\endcsname{#3}%
  \expandafter\gdef\csname zp@link@#1\endcsname{#4}%
  \ifnum#5=1
    \expandafter\gdef\csname zp@section@#1\endcsname{\@firstoftwo}%
  \else
    \expandafter\gdef\csname zp@section@#1\endcsname{\@secondoftwo}%
  \fi}
\newcommand{\artistname}[1]{\ifcsname zp@name@#1\endcsname\csname zp@name@#1\endcsname\fi}%
\newcommand{\artistlabel}[1]{\ifcsname zp@label@#1\endcsname\csname zp@label@#1\endcsname\fi}%
\newcommand{\artistlinklabel}[1]{\ifcsname zp@link@#1\endcsname\csname zp@link@#1\endcsname\fi}%
\newcommand{\ifartistsection}[3]{%
  \ifcsname zp@section@#1\endcsname\csname zp@section@#1\endcsname{#2}{#3}\else#3\fi}

% \artist[label]{slug}: link to the artist's section in the top-right corner
% of the song's page (D-003). Put it on the line of \song, once per song; for
% two artists write \artist{a}\artist{b} (the first is rightmost, a third is
% ignored). The text comes from the registry (link_label, else label) unless given. An empty or
% unknown slug, or an artist without a section, prints nothing.
% The links are right-aligned to the right margin (D-113). The list is built
% here and typeset at shipout; \song starts a new list.
\newcount\zp@artistcount
\newbox\zp@artistbox
% minipage and parbox are nested like in the old \interpret, which keeps its
% vertical placement and the font in effect at shipout (\Large in the book);
% \noindent cancels the negative \parindent of this style.
% The box around it puts the right edge of the links 1cm from the page edge.
\newcommand{\zp@artistpicture}{%
  \setbox\zp@artistbox\hbox{\zp@artistlist}%
  \put(0,\LenToUnit{0.98\paperheight}){\vtop{{\null}\hbox to \paperwidth{\hss
    \begin{minipage}{\wd\zp@artistbox}\noindent{\parbox{\wd\zp@artistbox}{\noindent\unhcopy\zp@artistbox}}\end{minipage}\kern1cm}}}}
\newcommand{\zpartistreset}{\global\zp@artistcount=0 \global\let\zp@artistlist\@empty}
\zpartistreset
\newcommand{\zp@nolabel}{}
\def\zp@nolabeldefault{\zp@nolabel}% what #1 expands to when no label is given
\newcommand{\artist}[2][\zp@nolabel]{%
  \def\zp@given{#1}%
  \ifartistsection{#2}{%
    \ifnum\zp@artistcount<2
      \ifnum\zp@artistcount=0
        \AddToShipoutPictureFG*{\zp@artistpicture}%
        \ifx\zp@given\zp@nolabeldefault
          \gdef\zp@itema{\hyperlink{#2}{$\rightarrow$~\artistlinklabel{#2}}}%
        \else
          \gdef\zp@itema{\hyperlink{#2}{$\rightarrow$~#1}}%
        \fi
        \global\let\zp@artistlist\zp@itema
      \else
        \ifx\zp@given\zp@nolabeldefault
          \gdef\zp@itemb{\hyperlink{#2}{$\rightarrow$~\artistlinklabel{#2}}}%
        \else
          \gdef\zp@itemb{\hyperlink{#2}{$\rightarrow$~#1}}%
        \fi
        \gdef\zp@artistlist{\zp@itemb\hspace{1.5em}\zp@itema}%
      \fi
      \global\advance\zp@artistcount by 1
    \fi
  }{}%
}
\makeatother
\InputIfFileExists{generated/artists}{}{}

