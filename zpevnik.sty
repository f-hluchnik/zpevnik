% zpevnik.sty -- packages and macros of the songbook.
% Everything a song needs lives here, so one song compiles with just
% \documentclass + \usepackage{zpevnik} (the Overleaf workflow, D-005).
% The document class, metadata and the list of songs stay in zpevnik.tex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{zpevnik}[2026/11/03 Songbook packages and macros]

