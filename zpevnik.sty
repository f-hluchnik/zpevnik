% zpevnik.sty -- packages and macros of the songbook.
% Everything a song needs lives here, so one song compiles with just
% \documentclass + \usepackage{zpevnik} (the Overleaf workflow).
% The document class, metadata and the list of songs stay in zpevnik.tex.
%
% Public interface used by the generated files and by zpevnik.tex:
% \songinclude, \zpregisterartist, \zpversion and \zprule. Internal macros
% carry the \zp@ prefix and may be renamed freely.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{zpevnik}[2026/11/06 Songbook packages and macros]

%PACKAGES AND PDF SETTINGS
\RequirePackage[utf8]{inputenc}
\RequirePackage[czech, british]{babel}
\RequirePackage[autostyle]{csquotes}
\RequirePackage{multicol}
\RequirePackage[top=1.5cm, left=2cm, right=1cm, bottom=2cm]{geometry}
\RequirePackage{tikz}
\RequirePackage{eso-pic}
\RequirePackage[T1]{fontenc}
\RequirePackage{setspace}
\RequirePackage{dashrule}
\RequirePackage{amssymb}
\RequirePackage{xcolor}
\RequirePackage{indentfirst}
% hyperref goes last: it redefines commands of the packages above
\RequirePackage[pdftex]{hyperref}
\hypersetup{colorlinks=true, linkcolor=gray}
\pdfminorversion=7

%PAGE LAYOUT AND NAMED LENGTHS
% The label (R:, 1., I:, ...) hangs in the left margin by this much: the first
% line of a paragraph starts left of the text block. With indentfirst this also
% holds for the first paragraph after a heading.
\newcommand*{\zp@labelhang}{10mm}
\setlength{\parindent}{-\zp@labelhang}
% Width of a label: the text after it always starts at the same place. It must
% hold the widest label (R1:, 24 pt).
\newcommand*{\labelw}{25pt}
% Gap between blocks (verse, chorus, ...). It can shrink to zero so that a song
% still fits on its page.
\newcommand*{\zp@blockgapsize}{20pt}
\newlength{\blocksep}
\setlength{\blocksep}{\zp@blockgapsize minus \zp@blockgapsize}
% In columns (multicols) the gap must not shrink: when balancing the columns,
% multicol would squeeze the blocks to zero.
\AddToHook{env/multicols/begin}{\setlength{\blocksep}{\zp@blockgapsize}}
% Shifts built into the macros (negative = up). The values are the ones the
% macros used to hard-code.
\newlength{\subshift}\setlength{\subshift}{-10mm}   % \sub: subtitle moves up to the title
\newlength{\hylshift}\setlength{\hylshift}{-15pt}   % \hyl: link line moves up to the previous block
\newlength{\groupshift}\setlength{\groupshift}{-2mm} % \groupbreak: space between line groups in a verse
\newlength{\songlinkgap}\setlength{\songlinkgap}{2mm} % \song: title to the "obsah" link
% The shifts of the dashed rule are fractions of the line height, not fixed
% points, so the rule also fits in a song set in a smaller size (\large). Before
% the rule: -13/18 of a line (13 pt at \Large); after it: +4/18, so the chords
% of the next block do not touch it.
\newcommand{\ruleshiftbefore}{\dimexpr-\baselineskip*13/18\relax} % rule moves up to the last line of the previous block
\newcommand{\ruleshiftafter}{\dimexpr\baselineskip*4/18\relax}    % \zp@nogap replaces the gap before the next block
% Dashed rule between tight verses (dashrule: thickness, dash pattern).
\newcommand*{\zp@dashthickness}{1pt}
\newcommand*{\zp@dashpattern}{3pt}
% Solid rule between parts of a song and in the contents. One macro, so the
% book and the generated contents draw the same line.
\newlength{\zprulethickness}\setlength{\zprulethickness}{0.03cm}
\newcommand*{\zprule}[1]{\rule{#1}{\zprulethickness}}
% Artist links in the top-right corner of a page: vertical position as a
% fraction of the page height, distance of the right edge from the page edge,
% gap between two links, and how many links a song may have.
\newcommand*{\zp@artistheight}{0.98}
\newlength{\zp@artistedge}\setlength{\zp@artistedge}{1cm}
\newcommand*{\zp@artistgap}{1.5em}
\newcommand*{\zp@maxartists}{2}

% \placetextbox{x}{y}{text}: typewriter text at (x\paperwidth, y\paperheight) of the page
\newcommand{\placetextbox}[3]{\AddToShipoutPictureFG*{\put(\LenToUnit{#1\paperwidth},\LenToUnit{#2\paperheight}){\vtop{{\null}\noindent\begin{minipage}{\linewidth}{\fontfamily{cmtt}\selectfont\begin{large}\parbox{\linewidth}{#3}\end{large}}\end{minipage}}}}}

%SONG HEADER
% Links: \hylo links to a target, \hyt creates one.
\newcommand{\hylo}[2]{\hyperlink{#1}{#2}}
\newcommand{\hyt}[1]{\hypertarget{#1}{}}
% Id of the song for \song, set by \songinclude (generated/include.tex). Without
% it no link target is created. The group keeps a font change inside a song
% (e.g. \large in a song that does not fit otherwise) from leaking into the next one.
\newcommand{\zp@songid}{}
\newcommand{\songinclude}[1]{\begingroup\gdef\zp@songid{#1}\include{pisnicky/#1}\endgroup}
\newcommand{\zp@songtarget}{\ifx\zp@songid\empty\else\hyt{\zp@songid}\gdef\zp@songid{}\fi}
% Small capitals as the old \sc did: \normalfont also drops the bold that the
% headings set, so only the title (\textbf in \song) stays bold.
\newcommand*{\zp@smallcaps}{\normalfont\scshape}
\newcommand{\song}[1]{%
  \global\zp@toptrue\global\zp@nogapfalse\zp@songtarget\zp@artistreset
  \section*{\Huge\zp@smallcaps\hypersetup{linkcolor=black}\hyperlink{obsah}{\textbf{#1}}\hypersetup{linkcolor=gray}\Large\hyperlink{obsah}{\hspace{\songlinkgap} $\rightarrow$~obsah}}
}
% \@nobreakfalse: right after a heading (\song) LaTeX would drop the space above
% \subsection*; the subtitle needs it.
\newcommand{\sub}[1]{\vspace{\subshift}\@nobreakfalse\subsection*{\large\zp@smallcaps{#1}}}

% \artist[label]{slug}: link to the artist's section in the top-right corner
% of the song's page. Put it on the line of \song, once per song; for two
% artists write \artist{a}\artist{b} (the first is rightmost, a third is
% ignored). The text comes from the registry (link_label, else label) unless
% given. An empty or unknown slug, or an artist without a section, prints
% nothing. The links are right-aligned to the right margin. The list is built
% here and typeset at shipout; \song starts a new list.
\newcount\zp@artistcount
\newbox\zp@artistbox
% minipage and parbox are nested to keep the vertical placement and the font in
% effect at shipout (\Large in the book); \noindent cancels the negative
% \parindent of this style. The kern puts the right edge of the links
% \zp@artistedge from the page edge.
\newcommand{\zp@artistpicture}{%
  \setbox\zp@artistbox\hbox{\zp@artistlist}%
  \put(0,\LenToUnit{\zp@artistheight\paperheight}){\vtop{{\null}\hbox to \paperwidth{\hss
    \begin{minipage}{\wd\zp@artistbox}\noindent{\parbox{\wd\zp@artistbox}{\noindent\unhcopy\zp@artistbox}}\end{minipage}\kern\zp@artistedge}}}}
\newcommand{\zp@artistreset}{\global\zp@artistcount=0 \global\let\zp@artistlist\@empty}
\zp@artistreset
\newcommand{\zp@artistlink}[2]{\hyperlink{#1}{$\rightarrow$~#2}}
% Adds a link (slug #1, text #2): the first one is registered for the page and
% stays rightmost, the second goes to its left.
\newcommand{\zp@addartist}[2]{%
  \ifnum\zp@artistcount=0
    \AddToShipoutPictureFG*{\zp@artistpicture}%
    \gdef\zp@artistfirst{\zp@artistlink{#1}{#2}}%
    \global\let\zp@artistlist\zp@artistfirst
  \else
    \gdef\zp@artistlist{\zp@artistlink{#1}{#2}\hspace{\zp@artistgap}\zp@artistfirst}%
  \fi
  \global\advance\zp@artistcount by 1 }
\NewDocumentCommand{\artist}{o m}{%
  \ifartistsection{#2}{%
    \ifnum\zp@artistcount<\zp@maxartists
      \IfNoValueTF{#1}%
        {\zp@addartist{#2}{\artistlinklabel{#2}}}%
        {\zp@addartist{#2}{#1}}%
    \fi
  }{}%
}

%BLOCKS AND LABELS
\newcommand{\lbl}[1]{\makebox[\labelw][l]{\textbf{#1}}}
\newcommand{\nv}{\hspace*{\labelw}}%no verse: indents the first line of unlabelled text under the text after a label
\newcommand{\refrain}[1]{\zp@blockgap\lbl{R:}{#1}}%refrain
\newcommand{\refrainn}[2]{\zp@blockgap\lbl{R{#1}:}{#2}}%numbered refrain
\newcommand{\refsm}[1]{\textbf{R{#1}.}}%small refrain
\newcommand{\refsme}[1]{\zp@blockgap\textbf{R{#1}.}}%small refrain, separated from the verse
\newcommand{\intro}[1]{\zp@blockgap\lbl{I:}{#1}}%intro
\newcommand{\bridge}[1]{\zp@blockgap\lbl{B:}{#1}}%bridge
\newcommand{\bridgesm}[1]{\textbf{B.}}%small bridge
\newcommand{\prechorus}[1]{\zp@blockgap\lbl{P:}{#1}}%pre-chorus
\newcommand{\solo}[1]{\zp@blockgap\lbl{S:}{#1}}%solo
\newcommand{\solon}[2]{\zp@blockgap\lbl{S{#1}:}{#2}}%numbered solo
\newcommand{\solosm}[1]{\zp@blockgap\lbl{S{#1}.}}%small solo
\newcommand{\cod}[1]{\zp@blockgap\lbl{C:}{#1}}%coda
% An empty number makes an unnumbered verse (no label, text aligned like the others).
\newcommand{\vers}[2]{\zp@blockgap\lbl{\if\relax\detokenize{#1}\relax\else#1.\fi}{#2}}%verse
% Change of singer: the name in italics right in the text (it is wider than
% \labelw), with the normal gap above the block.
\newcommand{\spk}[2]{\zp@blockgap\emph{#1:} #2}%speaker
\newcommand{\rep}[1]{$\backslash$: {#1} :$\backslash$}%repeat
\newcommand{\rec}[1]{\textit{rec: }{/#1/}}%recitative
% A note belongs to the block that follows: that block gets no gap (as after a
% separator). The note itself has the normal gap above it, except at the start
% of a song.
\newcommand{\note}[1]{\ifvmode\ifzp@top\else\zp@blockgap\fi\fi\emph{#1}\global\zp@nogaptrue\global\zp@topfalse}
% Link line to another song, pulled up to the previous block.
\newcommand{\hyl}[2]{\global\zp@topfalse\vspace{\hylshift}\nv\hyperlink{#1}{\textbf{$\rightarrow$#2}}}

%SEPARATORS AND VERTICAL SPACING
\newif\ifzp@top % nothing after the song title (and subtitle) yet: a note above has no gap. \song raises the flag; a block, a note and \hyl lower it.
\newif\ifzp@nogap % the next block has no gap (a separator or a note already replaced it). Always set globally (also inside a group, e.g. the argument of \solo); \song lowers it.
\newcommand{\zp@blockgap}{\global\zp@topfalse\ifzp@nogap\global\zp@nogapfalse\else\vspace{\blocksep}\fi}
% Separators replace the gap before the next block (via \zp@nogap), they do not remove it.
\newcommand{\groupbreak}{\\\vspace{\groupshift}\\}% space inside a verse between groups of lines
\newcommand{\blockrule}[1]{\vspace{\ruleshiftbefore}\nv\hdashrule{#1cm}{\zp@dashthickness}{\zp@dashpattern}\vspace{\ruleshiftafter}\global\zp@nogaptrue}% dashed rule between tight verses
% Solid rule between parts of a song. \par: the next block starts a new
% paragraph (like an empty line after center).
\newcommand{\partrule}{\begin{center}\zprule{\textwidth}\end{center}\par\global\zp@nogaptrue}

%CHORDS: \chord{X}text
% A chord has zero width but does not overlap the next chord on the same line.
% Rule: a chord and its text take max(text width, chord width + \chordsep);
% between two chords without text the width is chord width + \chordrunsep.
% The place where chords would overlap is widened; the text does not move
% otherwise. \chord reads the text up to the next chord, measures it and
% returns it unchanged (one pass, nothing is stored in the .aux). This holds in
% all songs: spaces in the text are not typed by hand, a pause is \gap{n}, a
% line of chords only is \chords{...}.
\definecolor{chordred}{RGB}{184, 39, 39}
\newcommand*{\chordsep}{0.5em}
\newcommand*{\chordrunsep}{1em}
\newcommand*{\gapunit}{0.5em}
\newcommand*{\zp@hyphenroom}{.3em} % how much wider the gap with a hyphen is than the hyphen
\newcommand*{\zp@notext}{.5pt}     % narrower text between chords does not count (chords right after each other)
\newsavebox\zp@chordbox
\newsavebox\zp@segbox
\newtoks\zp@segtoks
\newdimen\zp@pend % gap that the next chord inserts before itself (set by the previous one)
\newdimen\zp@pad
\newif\ifzp@afterletter
\newif\ifzp@nextletter
\newif\ifzp@split % the gap splits a word
% The position of every chord is written to \jobname.chords for tools/chord_gaps.py.
\newwrite\zp@trace
\AtBeginDocument{\immediate\openout\zp@trace=\jobname.chords\relax}
\def\zp@tracechord{%
  \pdfsavepos
  \edef\zp@tmp{\write\zp@trace{\noexpand\the\noexpand\pdflastxpos\space\noexpand\the\noexpand\pdflastypos\space\noexpand\thepage\space\number\wd\zp@chordbox}}%
  \zp@tmp}
\edef\zp@utftwo{\expandafter\string\csname UTFviii@two@octets\endcsname}
% Is the next token \zp@next a letter (ASCII, or a two-byte UTF-8 one like č, ž, é)?
\def\zp@testnextletter{%
  \zp@nextletterfalse
  \ifcat\noexpand\zp@next a\zp@nextlettertrue\fi
  \edef\zp@tmp{\noexpand\in@{\zp@utftwo}{\meaning\zp@next}}\zp@tmp
  \ifin@\zp@nextlettertrue\fi}
% The gap \zp@pad; inside a word it holds a centred hyphen (the gap widens to fit it).
\def\zp@space{%
  \ifzp@split
    \settowidth\dimen@{-}\advance\dimen@\zp@hyphenroom\relax
    \ifdim\zp@pad>\dimen@ \dimen@\zp@pad\fi
    \hbox to\dimen@{\hss-\hss}%
  \else\hskip\zp@pad\relax\fi}
\newcommand{\chord}[1]{%
  \leavevmode
  \zp@afterletterfalse
  \ifnum\lastnodetype=\z@ \zp@afterlettertrue\fi % a character before the chord
  \ifnum\lastnodetype=7 \zp@afterlettertrue\fi   % or a ligature
  \sbox\zp@chordbox{\textbf{\begin{tabular}[b]{@{}l@{}}\textcolor{chordred}{#1}\\
				\mbox{}\end{tabular}}}%
  \zp@pad\zp@pend \global\zp@pend\z@
  \zp@segtoks{}%
  \futurelet\zp@next\zp@chordfirst}
\def\zp@chordfirst{\zp@testnextletter\zp@scan@}
% Collects tokens up to the next \chord, \chords, \\, }, \par, \end or \begin.
\def\zp@scan{\futurelet\zp@next\zp@scan@}
\def\zp@scan@{%
  \let\zp@do\zp@grabtok
  \ifx\zp@next\@sptoken \let\zp@do\zp@grabspace\fi
  \ifx\zp@next\bgroup \let\zp@do\zp@grabgroup\fi
  \ifx\zp@next\chord \def\zp@do{\zp@finish\@ne}\fi
  \ifx\zp@next\chords \def\zp@do{\zp@finish\z@}\fi
  \ifx\zp@next\\\def\zp@do{\zp@finish\z@}\fi
  \ifx\zp@next\egroup \def\zp@do{\zp@finish\z@}\fi
  \ifx\zp@next\par \def\zp@do{\zp@finish\z@}\fi
  \ifx\zp@next\end \def\zp@do{\zp@finish\z@}\fi
  \ifx\zp@next\begin \def\zp@do{\zp@finish\z@}\fi
  \zp@do}
\def\zp@grabtok#1{\zp@segtoks\expandafter{\the\zp@segtoks#1}\zp@scan}
\def\zp@grabgroup#1{\zp@segtoks\expandafter{\the\zp@segtoks{#1}}\zp@scan}
\expandafter\def\expandafter\zp@grabspace\space{\zp@segtoks\expandafter{\the\zp@segtoks\space}\zp@scan}
% #1 = 1 when the text ends with another chord on the same line
\def\zp@finish#1{%
  \ifnum#1=\@ne
    \sbox\zp@segbox{\let\footnote\@gobble\the\zp@segtoks}% measure without side effects
    \ifdim\wd\zp@segbox<\zp@notext\relax
      \global\zp@pend\dimexpr\wd\zp@chordbox+\chordrunsep-\wd\zp@segbox\relax
    \else
      \global\zp@pend\dimexpr\wd\zp@chordbox+\chordsep-\wd\zp@segbox\relax
    \fi
    \ifdim\zp@pend<\z@ \global\zp@pend\z@\fi
  \fi
  \ifdim\zp@pad>\z@
    \zp@splitfalse
    \ifzp@afterletter\ifzp@nextletter\zp@splittrue\fi\fi
    \zp@space
  \fi
  \zp@tracechord
  \makebox[0pt][l]{\usebox\zp@chordbox}%
  \the\zp@segtoks}
% An intentional gap (pause), #1 characters of \gapunit.
\newcommand{\gap}[1]{\hspace{\dimexpr\gapunit*#1\relax}}
% Chords in a line of text without words (intro, end of a line), in red,
% \chordrunsep apart; \chords[0.55em]{...} narrows the gaps in this line only
% (a long line that would otherwise wrap).
\newcommand{\chords}[2][\chordrunsep]{\begingroup
  \edef\zp@rowsep{\the\dimexpr#1\relax}%
  \leavevmode\zp@chords@#2 \zp@chordsend{} \endgroup}
\def\zp@chords@#1 {\ifx\zp@chordsend#1\else
  \textbf{\textcolor{chordred}{#1}}\zp@chordsnext\fi}
\def\zp@chordsnext#1\fi{\fi\zp@chordsmore}
\def\zp@chordsmore{\futurelet\zp@next\zp@chordsmore@}
\def\zp@chordsmore@{\ifx\zp@next\zp@chordsend\expandafter\zp@chordsstop\else\hskip\zp@rowsep\relax\expandafter\zp@chords@\fi}
\def\zp@chordsstop\zp@chordsend#1 {}
\def\zp@chordsend{}

%CHORD SYMBOLS
% Convention: chord qualities other than minor are superscripts; bass
% movements are subscripts (\bas).
\newcommand{\bas}[1]{/\textsubscript{#1}}%subscript for bass movements
\newcommand{\add}[1]{\textsuperscript{#1}}%manual superscript
\newcommand{\maj}{\textsuperscript{$\triangle$}}%maj7 chords
\newcommand{\sus}[1]{\textsuperscript{sus#1}}%sus[] chords
\newcommand{\dm}{\textsuperscript{\Large$\circ$}}%dim chords (diminished seventh c-es-ges-a)
\newcommand{\hdm}{\textsuperscript{\large$\varnothing$}}%m7/5- chords (half diminished seventh c-es-ges-b)
\newcommand{\+}{\textsuperscript{+}}%aug chords (C-E-G#)
\newcommand{\bb}{\textsuperscript{\Large$\flat$}}%flat
\newcommand{\kk}{\textsuperscript{\#}}%sharp
\newcommand{\2}{\textsuperscript{2}}%2
\newcommand{\4}{\textsuperscript{4}}%4
\newcommand{\5}{\textsuperscript{5}}%5
\newcommand{\6}{\textsuperscript{6}}%6
\newcommand{\7}{\textsuperscript{7}}%7
\newcommand{\9}{\textsuperscript{9}}%9

%SONG METADATA (print nothing; read by the generator and the converter)
% \alttitle{Other title}   other name the song is known by; repeatable.
% \toctitle{TOC title}     title in the contents and the sort key when it must
%                          differ from \song, e.g. "Marie (Klus)".
% \collection{slug}        collection the song belongs to, e.g. filmy.
\newcommand{\alttitle}[1]{}
\newcommand{\toctitle}[1]{}
\newcommand{\collection}[1]{}

%REGISTRY LOOKUPS
% generated/artists.tex (tools/generate.py) registers every artist by slug.
% The lookups print nothing for an unknown slug, and a missing file is fine,
% so a single song still compiles without the generator (Overleaf).
% \zpregisterartist is public: the generated file calls it.
\newcommand{\zpregisterartist}[5]{%
  \expandafter\gdef\csname zp@name@#1\endcsname{#2}%
  \expandafter\gdef\csname zp@label@#1\endcsname{#3}%
  \expandafter\gdef\csname zp@link@#1\endcsname{#4}%
  \ifnum#5=1
    \expandafter\gdef\csname zp@section@#1\endcsname{\@firstoftwo}%
  \else
    \expandafter\gdef\csname zp@section@#1\endcsname{\@secondoftwo}%
  \fi}
\newcommand{\artistname}[1]{\ifcsname zp@name@#1\endcsname\csname zp@name@#1\endcsname\fi}%
\newcommand{\artistlabel}[1]{\ifcsname zp@label@#1\endcsname\csname zp@label@#1\endcsname\fi}%
\newcommand{\artistlinklabel}[1]{\ifcsname zp@link@#1\endcsname\csname zp@link@#1\endcsname\fi}%
\newcommand{\ifartistsection}[3]{%
  \ifcsname zp@section@#1\endcsname\csname zp@section@#1\endcsname{#2}{#3}\else#3\fi}
\InputIfFileExists{generated/artists}{}{}

%VERSION
% generated/version.tex (tools/generate.py) sets the real version: song count + 100.
% Without it the colophon shows a visibly wrong placeholder. \zpversion is
% public: zpevnik.tex prints it.
\newcommand{\zpversion}{?.??}
\InputIfFileExists{generated/version}{}{}
