\RequirePackage[czech, british]{babel}
\RequirePackage[autostyle]{csquotes}
\RequirePackage{multicol}
\RequirePackage[top=1.5cm, left=2cm, right=1cm, bottom=2cm]{geometry}
\RequirePackage{tikz}
\RequirePackage{eso-pic}
\RequirePackage[T1]{fontenc}
\RequirePackage{setspace}
\RequirePackage{dashrule}
\RequirePackage{amssymb}
\RequirePackage{xcolor}
\RequirePackage{indentfirst}
%poslední balík
\RequirePackage[pdftex]{hyperref}
\hypersetup{colorlinks=true, linkcolor=gray}

%příkazy pro hypertextové odkazy
\newcommand{\hylo}[2]{\hyperlink{#1}{#2}}
\newcommand{\hyl}[2]{\vspace{\hylshift}\nv\hyperlink{#1}{\textbf{$\rightarrow$#2}}}
\newcommand{\hyt}[1]{\hypertarget{#1}{}}

%id písničky pro \song: nastavuje ho \songinclude (generated/include.tex), bez něj se cíl odkazu nevytvoří
\newcommand{\zpsongid}{}
%skupina: písmo (např. \large v písni, která se jinak nevejde) neprosakuje do dalších písní
\newcommand{\songinclude}[1]{\begingroup\gdef\zpsongid{#1}\include{pisnicky/#1}\endgroup}
\newcommand{\zpsongtarget}{\ifx\zpsongid\empty\else\hyt{\zpsongid}\gdef\zpsongid{}\fi}


% předsazení prvního řádku odstavce: štítek (\lbl) visí v levém okraji; díky indentfirst
% i v prvním odstavci za nadpisem (H6)
\setlength{\parindent}{-10mm}
\definecolor{chordred}{RGB}{184, 39, 39}
\definecolor{chordblack}{RGB}{0, 0, 0}
%AKORDY: \chord{X}text (D-123)
% Akord má nulovou šířku, ale nepřekryje další akord na stejném řádku.
% Pravidlo: akord a jeho text zabírají max(šířka textu, šířka akordu + \chordsep);
% mezi dvěma akordy bez textu je šířka akordu + \chordrunsep.
% Místo, kde by se akordy překrývaly, se rozšíří; text se jinak nehýbe.
% \chord přečte text až k dalšímu akordu, změří ho a vrátí beze změny (jeden
% průchod, nic se neukládá do .aux). Platí ve všech písních; mezery v textu
% se nepíšou ručně, pauza je \gap{n}, řádek samých akordů je \chords{...}.
\newcommand*{\chordsep}{0.5em}
\newcommand*{\chordrunsep}{1em}
\newcommand*{\gapunit}{0.5em}
\newcommand*{\zp@hyphenroom}{.3em} % o kolik je mezera se spojovníkem širší než spojovník
\newcommand*{\zp@notext}{.5pt}     % užší text mezi akordy se nepočítá (akordy hned za sebou)
\newsavebox\zp@chordbox
\newsavebox\zp@segbox
\newtoks\zp@segtoks
\newdimen\zp@pend % mezera, kterou si před sebe vloží další akord (nastavuje ji předchozí)
\newdimen\zp@pad
\newif\ifzp@afterletter
\newif\ifzp@nextletter
\newif\ifzp@split % mezera rozdělí slovo
% Poloha každého akordu se zapisuje do \jobname.chords pro tools/chord_gaps.py.
\newwrite\zp@trace
\AtBeginDocument{\immediate\openout\zp@trace=\jobname.chords\relax}
\def\zp@tracechord{%
  \pdfsavepos
  \edef\zp@tmp{\write\zp@trace{\noexpand\the\noexpand\pdflastxpos\space\noexpand\the\noexpand\pdflastypos\space\noexpand\thepage\space\number\wd\zp@chordbox}}%
  \zp@tmp}
\edef\zp@utftwo{\expandafter\string\csname UTFviii@two@octets\endcsname}
% je následující token \zp@next písmeno (ASCII, nebo dvoubajtové UTF-8 jako č, ž, é)?
\def\zp@testnextletter{%
  \zp@nextletterfalse
  \ifcat\noexpand\zp@next a\zp@nextlettertrue\fi
  \edef\zp@tmp{\noexpand\in@{\zp@utftwo}{\meaning\zp@next}}\zp@tmp
  \ifin@\zp@nextlettertrue\fi}
% mezera \zp@pad; uvnitř slova s vystředěným spojovníkem (mezera se rozšíří, aby se vešel)
\def\zp@space{%
  \ifzp@split
    \settowidth\dimen@{-}\advance\dimen@\zp@hyphenroom\relax
    \ifdim\zp@pad>\dimen@ \dimen@\zp@pad\fi
    \hbox to\dimen@{\hss-\hss}%
  \else\hskip\zp@pad\relax\fi}
\newcommand{\chord}[1]{%
  \leavevmode
  \zp@afterletterfalse
  \ifnum\lastnodetype=\z@ \zp@afterlettertrue\fi % před akordem je znak
  \ifnum\lastnodetype=7 \zp@afterlettertrue\fi   % nebo ligatura
  \sbox\zp@chordbox{\textbf{\begin{tabular}[b]{@{}l@{}}\textcolor{chordred}{#1}\\
				\mbox{}\end{tabular}}}%
  \zp@pad\zp@pend \global\zp@pend\z@
  \zp@segtoks{}%
  \futurelet\zp@next\zp@chordfirst}
\def\zp@chordfirst{\zp@testnextletter\zp@scan@}
% sbírá tokeny až k dalšímu \chord, \chords, \\, }, \par, \end nebo \begin
\def\zp@scan{\futurelet\zp@next\zp@scan@}
\def\zp@scan@{%
  \let\zp@do\zp@grabtok
  \ifx\zp@next\@sptoken \let\zp@do\zp@grabspace\fi
  \ifx\zp@next\bgroup \let\zp@do\zp@grabgroup\fi
  \ifx\zp@next\chord \def\zp@do{\zp@finish\@ne}\fi
  \ifx\zp@next\chords \def\zp@do{\zp@finish\z@}\fi
  \ifx\zp@next\\\def\zp@do{\zp@finish\z@}\fi
  \ifx\zp@next\egroup \def\zp@do{\zp@finish\z@}\fi
  \ifx\zp@next\par \def\zp@do{\zp@finish\z@}\fi
  \ifx\zp@next\end \def\zp@do{\zp@finish\z@}\fi
  \ifx\zp@next\begin \def\zp@do{\zp@finish\z@}\fi
  \zp@do}
\def\zp@grabtok#1{\zp@segtoks\expandafter{\the\zp@segtoks#1}\zp@scan}
\def\zp@grabgroup#1{\zp@segtoks\expandafter{\the\zp@segtoks{#1}}\zp@scan}
\expandafter\def\expandafter\zp@grabspace\space{\zp@segtoks\expandafter{\the\zp@segtoks\space}\zp@scan}
% #1 = 1, když text končí dalším akordem na stejném řádku
\def\zp@finish#1{%
  \ifnum#1=\@ne
    \sbox\zp@segbox{\let\footnote\@gobble\the\zp@segtoks}% změřit bez vedlejších účinků
    \ifdim\wd\zp@segbox<\zp@notext\relax
      \global\zp@pend\dimexpr\wd\zp@chordbox+\chordrunsep-\wd\zp@segbox\relax
    \else
      \global\zp@pend\dimexpr\wd\zp@chordbox+\chordsep-\wd\zp@segbox\relax
    \fi
    \ifdim\zp@pend<\z@ \global\zp@pend\z@\fi
  \fi
  \ifdim\zp@pad>\z@
    \zp@splitfalse
    \ifzp@afterletter\ifzp@nextletter\zp@splittrue\fi\fi
    \zp@space
  \fi
  \zp@tracechord
  \makebox[0pt][l]{\usebox\zp@chordbox}%
  \the\zp@segtoks}
% záměrná mezera (pauza), #1 znaků po \gapunit
\newcommand{\gap}[1]{\hspace{\dimexpr\gapunit*#1\relax}}
% akordy v řádku textu bez slov (intro, konec řádku), červeně, od sebe \chordrunsep;
% \chords[0.55em]{...} zúží mezery jen v tomto řádku (dlouhý řádek, který se jinak zalomí)
\newcommand{\chords}[2][\chordrunsep]{\begingroup
  \edef\zp@rowsep{\the\dimexpr#1\relax}%
  \leavevmode\zp@chords@#2 \zp@chordsend{} \endgroup}
\def\zp@chords@#1 {\ifx\zp@chordsend#1\else
  \textbf{\textcolor{chordred}{#1}}\zp@chordsnext\fi}
\def\zp@chordsnext#1\fi{\fi\zp@chordsmore}
\def\zp@chordsmore{\futurelet\zp@next\zp@chordsmore@}
\def\zp@chordsmore@{\ifx\zp@next\zp@chordsend\expandafter\zp@chordsstop\else\hskip\zp@rowsep\relax\expandafter\zp@chords@\fi}
\def\zp@chordsstop\zp@chordsend#1 {}
\def\zp@chordsend{}
%\newcommand{\chord}[2][l]{} % alternativní příkaz pro akordy pro zpěvních bez akordů
\pdfminorversion=7

%%KONVENCE
	% charakteristiky akordů kromě moll se píšou do horního indexu
	% pochody v basu se píšou do dolního indexu (\bas)
%AKORDY
\newcommand{\bas}[1]{/\textsubscript{#1}}%dolní index pro přechody v basu
\newcommand{\add}[1]{\textsuperscript{#1}}%manuální horní index
\newcommand{\maj}{\textsuperscript{$\triangle$}}%maj7 akordy
\newcommand{\sus}[1]{\textsuperscript{sus#1}}%sus[] akordy
\newcommand{\dm}{\textsuperscript{\Large{$\circ$}}}%dim akordy (zmenšený septakord c-es-ges-a, diminished)
\newcommand{\hdm}{\textsuperscript{\large{$\varnothing$}}}%m7/5- akordy (malý zmenšený septakord c-es-ges-b, half diminished)
\newcommand{\+}{\textsuperscript{+}}%aug akordy (C-E-G#)
\newcommand{\bb}{\textsuperscript{\Large$\flat$}}%béčko
\newcommand{\kk}{\textsuperscript{\#}}%křížek
\newcommand{\2}{\textsuperscript{2}}%2
\newcommand{\4}{\textsuperscript{4}}%4
\newcommand{\5}{\textsuperscript{5}}%5
\newcommand{\6}{\textsuperscript{6}}%6
\newcommand{\7}{\textsuperscript{7}}%7
\newcommand{\9}{\textsuperscript{9}}%9
\newcommand{\note}[1]{\emph{#1}\global\zp@nogaptrue}%poznámka patří k následujícímu bloku: ten nemá mezeru (jako za oddělovačem)

%MEZERY
%horizontální
%šířka štítku (R:, 1., I:, ...): text za štítkem vždy začíná na stejném místě (C5); musí se do ní vejít nejširší štítek (R1:, 24 pt)
\newcommand*{\labelw}{25pt}
\newcommand{\lbl}[1]{\makebox[\labelw][l]{\textbf{#1}}}
\newcommand{\nv}{\hspace*{\labelw}}%no verse - odsazení prvního řádku pro neoznačené texty, pod text za štítkem
%vertikální
%mezera mezi bloky (sloka, refrén, ...): 20 pt, smrštitelná až na nulu, aby se píseň vešla na stránku (D-124)
\newlength{\blocksep}
\setlength{\blocksep}{20pt minus 20pt}
%ve sloupcích (multicols) se mezera nesmršťuje: multicol by při vyvažování sloupců stlačil bloky na nulu
\AddToHook{env/multicols/begin}{\setlength{\blocksep}{20pt}}
%posuny zabudované v makrech (záporné = nahoru); hodnoty jsou ty, které makra měla dosud napevno (V6)
\newlength{\subshift}\setlength{\subshift}{-10mm}%\sub: podnázev se posune nahoru k názvu písně
\newlength{\hylshift}\setlength{\hylshift}{-15pt}%\hyl: řádek s odkazem se posune nahoru k předchozímu bloku
%posuny čáry jsou zlomky řádkování (\baselineskip), ne pevné body, aby čára seděla i v písni s menším písmem (\large); před čárou -13/18 řádku (při \Large 13 pt), za ní +4/18 (akordy dalšího bloku se čáry nedotýkají)
\newcommand{\ruleshiftbefore}{\dimexpr-\baselineskip*13/18\relax}%\blockrule: čára se posune nahoru, blíž k poslednímu řádku předchozího bloku
\newcommand{\ruleshiftafter}{\dimexpr\baselineskip*4/18\relax}%\blockrule: za čárou; mezeru před dalším blokem nahrazuje \zp@nogap
\newif\ifzp@nogap % následující blok nemá mezeru (oddělovač nebo poznámka ji už nahradily); vždy se nastavuje globálně (i uvnitř skupiny, např. argumentu \solo); \song vlajku shodí
\newcommand{\zp@blockgap}{\ifzp@nogap\global\zp@nogapfalse\else\vspace{\blocksep}\fi}
%oddělovače: nahrazují mezeru před dalším blokem (\zp@nogap), ne ji rušují
\newcommand{\groupbreak}{\\\vspace{-2mm}\\}%mezera uvnitř sloky mezi skupinami řádků
\newcommand{\blockrule}[1]{\vspace{\ruleshiftbefore}\nv\hdashrule{#1cm}{1pt}{3pt}\vspace{\ruleshiftafter}\global\zp@nogaptrue}%čárkovaná čára mezi těsnými slokami
\newcommand{\partrule}{\begin{center}\rule{\textwidth}{0.03cm}\end{center}\par\global\zp@nogaptrue}%plná čára mezi částmi písně; \par: další blok začíná nový odstavec (jako prázdný řádek za center, H6)

%MAIN
\newcommand{\song}[1]{\global\zp@nogapfalse\zpsongtarget\zpartistreset\section*{\Huge\sc\hypersetup{linkcolor=black}\hyperlink{obsah}{\textbf{#1}}\hypersetup{linkcolor=gray}\Large\hyperlink{obsah}{\hspace{2mm} $\rightarrow$~obsah}}
}%název
% \@nobreakfalse: hned za nadpisem (\song) by LaTeX vynechal mezeru nad \subsection*; podnázev ji má (H6)
\newcommand{\sub}[1]{\vspace{\subshift}\@nobreakfalse\subsection*{\large\expandafter\sc{#1}}}%podnázev
\newcommand{\refrain}[1]{\zp@blockgap\lbl{R:}{#1}}%refrain
\newcommand{\refrainn}[2]{\zp@blockgap\lbl{R{#1}:}{#2}}%číslovaný refrain
\newcommand{\refsm}[1]{\textbf{R{#1}.}}%malý refrain
\newcommand{\refsme}[1]{\zp@blockgap\textbf{R{#1}.}}%malý refrain oddělený od sloky
\newcommand{\intro}[1]{\zp@blockgap\lbl{I:}{#1}}%intro
\newcommand{\bridge}[1]{\zp@blockgap\lbl{B:}{#1}}%bridge
\newcommand{\bridgesm}[1]{\textbf{B.}}%malý bridge
\newcommand{\prechorus}[1]{\zp@blockgap\lbl{P:}{#1}}%pre-chorus
\newcommand{\solo}[1]{\zp@blockgap\lbl{S:}{#1}}%solo
\newcommand{\solon}[2]{\zp@blockgap\lbl{S{#1}:}{#2}}%solo
\newcommand{\solosm}[1]{\zp@blockgap\lbl{S{#1}.}}%solo
\newcommand{\cod}[1]{\zp@blockgap\lbl{C:}{#1}}%coda
%prázdné číslo = neočíslovaná sloka (bez štítku, text zarovnaný jako u ostatních)
\newcommand{\vers}[2]{\zp@blockgap\lbl{\if\relax\detokenize{#1}\relax\else#1.\fi}{#2}}%sloka
\newcommand{\rep}[1]{$\backslash$: {#1} :$\backslash$}%repetice
\newcommand{\rec}[1]{\textit{rec: }{/#1/}}%recitativ

% \placetextbox{x}{y}{text}: text psaným strojem na pozici (x\paperwidth, y\paperheight) stránky
\newcommand{\placetextbox}[3]{\AddToShipoutPictureFG*{\put(\LenToUnit{#1\paperwidth},\LenToUnit{#2\paperheight}){\vtop{{\null}\noindent\begin{minipage}{\linewidth}{\fontfamily{cmtt}\selectfont\begin{large}\parbox{\linewidth}{#3}\end{large}}\end{minipage}}}}}

