{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f-hluchnik/zpevnik/blob/master/tools/songs.schema.json",
  "title": "songs.json",
  "description": "The songs of the full songbook for the website (docs/DECISIONS.md D-165). Generated by tools/songs_json.py, never edited. Every field is always present; null only where the schema allows it. Every object in a list of mixed kinds has a 'type'. Text is what the PDF prints. Any change of this shape raises schemaVersion.",
  "type": "object",
  "required": ["schemaVersion", "version", "songs", "contents", "artists"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {
      "description": "The version of the build, as the PDF prints it; the patch is '?' in a build without the Git history (never in a release).",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}\\.([0-9]+|\\?)$"
    },
    "songs": {
      "description": "The published songs of the full book, in book order.",
      "type": "array",
      "items": {"$ref": "#/$defs/song"}
    },
    "contents": {
      "description": "The letter sections of the contents, in book order.",
      "type": "array",
      "items": {"$ref": "#/$defs/letterSection"}
    },
    "artists": {
      "description": "Every registry entry a song names, in the order of the artist index.",
      "type": "array",
      "items": {"$ref": "#/$defs/artist"}
    }
  },
  "$defs": {
    "id": {
      "description": "A song id, a registry slug or a score name: safe in a URL path.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "nonEmptyString": {"type": "string", "minLength": 1},

    "song": {
      "type": "object",
      "required": ["id", "title", "tocTitle", "altTitles", "subtitle", "artists", "collections", "see", "page",
                   "columns", "footnotes", "body"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/text"},
        "tocTitle": {"description": "The title the contents list.", "$ref": "#/$defs/nonEmptyString"},
        "altTitles": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "subtitle": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
        "artists": {"type": "array", "items": {"$ref": "#/$defs/artistRef"}},
        "collections": {"description": "Registry slugs.", "type": "array", "items": {"$ref": "#/$defs/id"}},
        "see": {"type": "array", "items": {"$ref": "#/$defs/seeAlso"}},
        "page": {"description": "The page in the full book's PDF, also its page index.", "type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "footnotes": {
          "description": "Numbered per song from 1 (the title's first); each footnote is lines of text.",
          "type": "array",
          "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
        },
        "body": {"type": "array", "items": {"$ref": "#/$defs/bodyItem"}}
      }
    },
    "artistRef": {
      "type": "object",
      "required": ["slug", "label"],
      "additionalProperties": false,
      "properties": {
        "slug": {"$ref": "#/$defs/id"},
        "label": {"description": "Instead of the registry's linkLabel; null: the registry's.",
                  "anyOf": [{"type": "null"}, {"$ref": "#/$defs/nonEmptyString"}]}
      }
    },
    "seeAlso": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/text"}
      }
    },

    "bodyItem": {
      "anyOf": [
        {"$ref": "#/$defs/block"},
        {"$ref": "#/$defs/speakerBlock"},
        {"$ref": "#/$defs/cueBlock"},
        {"$ref": "#/$defs/note"},
        {"$ref": "#/$defs/rule"}
      ]
    },
    "block": {
      "description": "A part of the song.",
      "type": "object",
      "required": ["type", "kind", "number", "label", "lines"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "block"},
        "kind": {"enum": ["verse", "chorus", "prechorus", "bridge", "solo", "intro", "coda"]},
        "number": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nonEmptyString"}]},
        "label": {"description": "As printed, 'R2.'; empty for a verse without a number.", "type": "string"},
        "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}}
      }
    },
    "speakerBlock": {
      "description": "A part with a singer's name in the label column.",
      "type": "object",
      "required": ["type", "name", "lines"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "speakerBlock"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}}
      }
    },
    "cueBlock": {
      "description": "A part sung again, as a block of its own; its line holds what follows the label (often nothing).",
      "type": "object",
      "required": ["type", "label", "line"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "cueBlock"},
        "label": {"$ref": "#/$defs/nonEmptyString"},
        "line": {"$ref": "#/$defs/line"}
      }
    },
    "rule": {
      "type": "object",
      "required": ["type", "kind"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "rule"},
        "kind": {"description": "dashed: between tight verses; solid: between parts.", "enum": ["dashed", "solid"]}
      }
    },

    "line": {
      "type": "object",
      "required": ["groupStart", "items"],
      "additionalProperties": false,
      "properties": {
        "groupStart": {"description": "A gap of a line stands before it.", "type": "boolean"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/lineItem"}}
      }
    },
    "lineItem": {
      "anyOf": [
        {"$ref": "#/$defs/segment"},
        {"$ref": "#/$defs/repeatStart"},
        {"$ref": "#/$defs/repeatEnd"},
        {"$ref": "#/$defs/cue"},
        {"$ref": "#/$defs/note"},
        {"$ref": "#/$defs/speaker"},
        {"$ref": "#/$defs/score"}
      ]
    },
    "segment": {
      "description": "A chord and the text under it, up to the next chord.",
      "type": "object",
      "required": ["type", "chord", "lyrics", "endsInWord"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "segment"},
        "chord": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/chord"}]},
        "lyrics": {"$ref": "#/$defs/text"},
        "endsInWord": {"description": "The lyrics end inside a word the next chord splits: where the gap before that chord is widened, the PDF prints a hyphen in it.",
                       "type": "boolean"}
      }
    },
    "repeatStart": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {"type": {"const": "repeatStart"}}
    },
    "repeatEnd": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {"type": {"const": "repeatEnd"}}
    },
    "cue": {
      "description": "A part sung again here, by its printed label.",
      "type": "object",
      "required": ["type", "label"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "cue"},
        "label": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "note": {
      "description": "A short remark (capo, tempo), printed in italics.",
      "type": "object",
      "required": ["type", "content"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "note"},
        "content": {"$ref": "#/$defs/text"}
      }
    },
    "speaker": {
      "description": "A singer's name before the line.",
      "type": "object",
      "required": ["type", "name"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "speaker"},
        "name": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "score": {
      "description": "The image of scores/<name>.mscz (released as <name>.svg).",
      "type": "object",
      "required": ["type", "name"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "score"},
        "name": {"$ref": "#/$defs/id"}
      }
    },

    "chord": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "position"],
        "additionalProperties": false,
        "properties": {
          "text": {"$ref": "#/$defs/nonEmptyString"},
          "position": {"enum": ["base", "superscript", "subscript"]}
        }
      }
    },

    "text": {
      "type": "array",
      "items": {"anyOf": [{"$ref": "#/$defs/run"}, {"$ref": "#/$defs/gap"}, {"$ref": "#/$defs/footnoteRef"}]}
    },
    "run": {
      "description": "Text in one style.",
      "type": "object",
      "required": ["type", "text", "style"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "run"},
        "text": {"$ref": "#/$defs/nonEmptyString"},
        "style": {
          "description": "Empty: plain. echo: echo or backing vocals, raised and in italics.",
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["italic", "bold", "echo", "subscript", "superscript"]}
        }
      }
    },
    "gap": {
      "description": "An intentional pause of this length.",
      "type": "object",
      "required": ["type", "em"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "gap"},
        "em": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "footnoteRef": {
      "description": "Where footnote number n (footnotes[n - 1]) stands.",
      "type": "object",
      "required": ["type", "number"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "footnote"},
        "number": {"type": "integer", "minimum": 1}
      }
    },

    "entry": {
      "description": "An entry of the contents or of an artist: the song's title, or one of its other titles.",
      "type": "object",
      "required": ["id", "title", "alternative"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "alternative": {"type": "boolean"}
      }
    },
    "letterSection": {
      "type": "object",
      "required": ["letter", "entries"],
      "additionalProperties": false,
      "properties": {
        "letter": {"description": "'CH' is one letter.", "$ref": "#/$defs/nonEmptyString"},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
      }
    },
    "artist": {
      "type": "object",
      "required": ["slug", "name", "label", "linkLabel", "kind", "section", "entries"],
      "additionalProperties": false,
      "properties": {
        "slug": {"$ref": "#/$defs/id"},
        "name": {"description": "The heading of the artist's section ('Surname, First').", "$ref": "#/$defs/nonEmptyString"},
        "label": {"description": "How the index names the artist.", "$ref": "#/$defs/nonEmptyString"},
        "linkLabel": {"description": "The link on the artist's songs.", "$ref": "#/$defs/nonEmptyString"},
        "kind": {"enum": ["artist", "collection"]},
        "section": {"description": "The book has a section for this entry.", "type": "boolean"},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
      }
    }
  }
}
