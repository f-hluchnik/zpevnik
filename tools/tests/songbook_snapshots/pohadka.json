          "ITALIC"
         ]
        },
        {
         "type": "Run",
         "text": "/ Takhle nějak to bylo: Jedlo se, zpívalo, pilo,",
         "style": []
        }
       ]
      }
     ],
     "group_start": false
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "princezna zářila štěstím v hotelu nad náměstím.",
         "style": []
        }
       ]
      }
     ],
     "group_start": false
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "Drak hlídal u dveří sálu, na krku pletenou šálu,",
         "style": []
        }
       ]
      }
     ],
     "group_start": true
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "dědové Vševědi okolo Popelky žvatlavě slibují šaty a kabelky.",
         "style": []
        }
       ]
      }
     ],
     "group_start": false
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "Každý si odnáší kousíček úsměvu, dešťový mraky se chystaly ke zpěvu,",
         "style": []
        }
       ]
      }
     ],
     "group_start": true
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "hosté se sjíždějí k veliké veselce, paprsky luceren metají kozelce.",
         "style": []
        }
       ]
      }
     ],
     "group_start": false
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "A stíny ořechů orvaných dohola pletou se letícím kočárům pod kola.",
         "style": []
        }
       ]
      }
     ],
     "group_start": true
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "Šmudla si přivezl v odřeným Wartburgu kámošku z dětství, prej nějakou Sněhurku.",
         "style": []
        }
       ]
      }
     ],
     "group_start": false
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "Vrátný se zohýbá pro tučné spropitné, a kdo mu proklouzne, tak toho nechytne.",
         "style": []
        }
       ]
      }
     ],
     "group_start": true
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "Kouzelník za dvacku vykouzlí pět bonů a vítr na věži opřel se do zvonů.",
         "style": []
        }
       ]
      }
     ],
     "group_start": false
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "Honzové, princové, víly i sudičky chopí se poháru, nože i vidličky.",
         "style": []
        }
       ]
      }
     ],
     "group_start": true
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "„Na zdraví nevěsty, na zdraví ženicha!“, dvě sousta do kapsy a jedno do břicha.",
         "style": []
        }
       ]
      }
     ],
     "group_start": false
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "Náhle se za oknem objevil skřítek, rozhrnul oponu z máminých kytek,",
         "style": []
        }
       ]
      }
     ],
     "group_start": true
    },
    {
     "type": "Line",
     "items": [
      {
       "type": "Segment",
       "chord": null,
       "text": [
        {
         "type": "Run",
         "text": "pěkně se usmál a pěkně se podíval, a pak mi potichu do ucha zazpíval. /",
         "style": []
        }
       ]
      }
     ],
     "group_start": false
    }
